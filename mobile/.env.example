# Sao chép thành .env rồi điền giá trị thật (KHÔNG commit .env).
# Trên điện thoại thật, "localhost" là chính cái điện thoại: dùng IP LAN của máy chạy backend, vd 192.168.1.10.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1

# Cùng dự án Supabase với web (frontend/.env.local: NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Thông báo đẩy: thường không cần điền, `npx eas-cli init` đã ghi ID dự án vào app.json. Chỉ dùng biến này khi không chạy lệnh đó.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Tuỳ chọn: địa chỉ web Studia, dùng làm trang đặt lại mật khẩu trong email "quên mật khẩu".
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:3000
