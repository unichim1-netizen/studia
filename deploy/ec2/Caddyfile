# Tên miền sslip.io tự trỏ về IP 3.25.144.63 (không cần mua domain). Có domain riêng thì thay vào đây và trỏ A record về Elastic IP.
api.3-25-144-63.sslip.io {
	encode gzip
	request_body {
		max_size 150MB
	}
	# Audio Listening (tệp tĩnh, hỗ trợ Range để tua); đặt NEXT_PUBLIC_AUDIO_BASE_URL=https://<domain>/audio
	handle /audio/* {
		root * /srv
		header Cache-Control "public, max-age=2592000"
		header Access-Control-Allow-Origin "*"
		file_server
	}

	handle {
		reverse_proxy api:8000
	}
}
